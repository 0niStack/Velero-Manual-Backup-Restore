# ---- Shared config for 01 and 02 (edit before running) ----
VELERO_VERSION="v1.17.0"
AWS_PLUGIN_VERSION="v1.13.0"        # velero-plugin-for-aws, must match Velero version

# RustFS (S3-compatible) backup storage
RUSTFS_ACCESS_KEY="rustfsadmin"
RUSTFS_SECRET_KEY="ChangeMe-Strong-Secret-123"
BUCKET="velero"
REGION="us-east-1"                   # any value works for RustFS
# Must be reachable from the Kubernetes nodes/pods (use the RustFS host IP, not localhost)
S3_URL="http://192.168.1.10:9000"

# Demo namespace + schedule
NAMESPACE="demo-app"
SCHEDULE_NAME="demo-app-daily"
